# Copy this file to .env.local for local dev, and set the same two
# variables in Vercel → your project → Settings → Environment Variables
# (Production + Preview) before deploying.
#
# Both come from: Razorpay Dashboard → Settings → API Keys.
# RAZORPAY_KEY_ID is not secret (it's also sent to the browser to open the
# Checkout modal). RAZORPAY_KEY_SECRET is secret — used only server-side in
# lib/razorpay.ts to create orders and verify payments. Never commit real
# values or expose the secret to the client.

RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
