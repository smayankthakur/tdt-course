# Copy this file to .env.local (local dev) and also set it in your
# Vercel project's Environment Variables (Production + Preview).
#
# Find this in the Razorpay Dashboard → Settings → API Keys → Key Secret.
# NEVER commit the real value or expose it to the client — it's only read
# server-side, in lib/razorpay.ts.
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
