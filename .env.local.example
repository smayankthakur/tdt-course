# Razorpay (get these from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Reading price in INR paise (8500 INR = 850000 paise)
READING_PRICE_PAISE=850000

# SMTP (used to email the Google Form link after a verified payment)
# Any SMTP provider works: Gmail App Password, Zoho, Resend SMTP, SendGrid SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=thedivinetarothindi@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="The Divine Tarot <thedivinetarothindi@gmail.com>"

# Where the booking form email points to
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLScOt9_M6dXtizMxsHsP9tyQ3hLUUXx2J9NrV_Naq7KyloKjAA/viewform
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLScOt9_M6dXtizMxsHsP9tyQ3hLUUXx2J9NrV_Naq7KyloKjAA/viewform
